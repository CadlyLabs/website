---
import { StorefrontIcon, PlugsConnectedIcon, ClockIcon, ShieldCheckIcon } from "@phosphor-icons/react";
import { FadeInView } from "@/components/animations/FadeInView";

const differentiators = [
  {
    id: "sector",
    title: "Conocemos tu sector",
    description:
      "Nuestro cofundador tenía una sala de despiece. No somos consultores adivinando — conocemos el día a día de la industria alimentaria.",
    Icon: StorefrontIcon,
  },
  {
    id: "no-migration",
    title: "Sin cambiar lo que ya funciona",
    description:
      "Nos integramos con tu ERP, tu Excel, tu forma de trabajar. Añadimos, no sustituimos.",
    Icon: PlugsConnectedIcon,
  },
  {
    id: "fast",
    title: "Resultados en semanas, no meses",
    description:
      "Primera puesta en marcha en 2-4 semanas. Si no ves valor, lo dejamos.",
    Icon: ClockIcon,
  },
  {
    id: "inspection",
    title: "Siempre listo para la inspección",
    description:
      "¿Auditoría sorpresa? 2 clics para tener todo listo. Trazabilidad completa, registros al día.",
    Icon: ShieldCheckIcon,
  },
];
---

<section class="bg-surface py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <FadeInView client:visible className="text-center">
      <h2 class="font-heading text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl">
        Por qué empresas alimentarias confían en nosotros
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        Nacimos resolviendo los problemas que tú vives cada día en tu negocio.
      </p>
    </FadeInView>

    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      {differentiators.map((item, index) => {
        const Icon = item.Icon;
        return (
          <FadeInView client:visible delay={index * 0.1}>
            <div class="group rounded-3xl border border-gray-200 bg-white p-6 transition-all hover:border-brand-200 hover:shadow-lg">
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-brand-50 transition-colors group-hover:bg-brand-100">
                  <Icon className="h-6 w-6 text-brand-600" />
                </div>
                <div>
                  <h3 class="font-heading text-lg font-bold text-gray-900">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-gray-600">
                    {item.description}
                  </p>
                </div>
              </div>
            </div>
          </FadeInView>
        );
      })}
    </div>
  </div>
</section>
