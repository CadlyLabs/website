---
import { StorefrontIcon, CodeIcon, ClockIcon, UsersIcon } from "@phosphor-icons/react";
import { FadeInView } from "@/components/animations/FadeInView";

const differentiators = [
  {
    id: "sector",
    title: "Especialistas en alimentación",
    description:
      "No somos una agencia genérica. Conocemos el día a día de la industria alimentaria y sabemos dónde están los cuellos de botella reales.",
    Icon: StorefrontIcon,
  },
  {
    id: "build",
    title: "Construimos, no vendemos licencias",
    description:
      "Desarrollamos código propio y soluciones a medida. Sin dependencias de terceros ni suscripciones a plataformas que no necesitas.",
    Icon: CodeIcon,
  },
  {
    id: "fast",
    title: "Resultados en semanas, no meses",
    description:
      "Nuestra metodología ágil nos permite entregar valor rápido. Ves los primeros resultados en menos de un mes.",
    Icon: ClockIcon,
  },
  {
    id: "team",
    title: "Equipo pequeño, acceso directo",
    description:
      "Hablas directamente con quien construye tu sistema. Sin intermediarios, sin gestores de cuenta, solo soluciones.",
    Icon: UsersIcon,
  },
];
---

<section class="bg-surface py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <FadeInView client:visible className="max-w-3xl">
      <span class="inline-flex items-center rounded-full bg-brand-100 px-4 py-1.5 text-sm font-medium text-brand-700 font-body">
        Por qué Cadly Labs
      </span>
      <h2 class="mt-6 font-heading text-4xl font-bold text-gray-900 sm:text-5xl md:text-6xl">
        IA de verdad. Resultados en semanas.
      </h2>
      <p class="mt-6 text-xl leading-relaxed text-gray-600 font-body">
        Olvídate de promesas vacías. Somos un equipo de IA que empezó resolviendo los problemas reales de la industria alimentaria.
      </p>
    </FadeInView>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {differentiators.map((item, index) => {
        const Icon = item.Icon;
        return (
          <FadeInView client:visible delay={index * 0.1} className={index % 2 === 1 ? "md:mt-12" : ""}>
            <div class="group h-full rounded-3xl border border-gray-200 bg-white p-8 transition-all hover:border-brand-200 hover:shadow-lg">
              <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 transition-colors group-hover:bg-brand-100">
                <Icon className="h-7 w-7 text-brand-600" />
              </div>
              <h3 class="font-heading text-2xl font-bold text-gray-900">
                {item.title}
              </h3>
              <p class="mt-4 text-base leading-relaxed text-gray-600 font-body">
                {item.description}
              </p>
            </div>
          </FadeInView>
        );
      })}
    </div>
  </div>
</section>
