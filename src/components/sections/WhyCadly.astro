---
import { StorefrontIcon, PlugsConnectedIcon, ClockIcon, ShieldCheckIcon } from "@phosphor-icons/react";
import { FadeInView } from "@/components/animations/FadeInView";

const differentiators = [
  {
    id: "sector",
    title: "Hablamos tu mismo idioma",
    description:
      "Nuestro cofundador tenía una sala de despiece. No somos consultores adivinando — conocemos el día a día de la industria alimentaria.",
    Icon: StorefrontIcon,
  },
  {
    id: "no-migration",
    title: "Sin líos de migración",
    description:
      "Nos conectamos a tu ERP, tu Excel o tu forma de trabajar actual. Sumamos inteligencia sin romper lo que ya te funciona.",
    Icon: PlugsConnectedIcon,
  },
  {
    id: "fast",
    title: "Resultados en 2-4 semanas",
    description:
      "Ves los primeros resultados en menos de un mes. Si la IA no te aporta valor real desde el primer día, lo dejamos.",
    Icon: ClockIcon,
  },
  {
    id: "inspection",
    title: "Auditorías bajo control",
    description:
      "Tenlo todo listo para la inspección en dos clics. Trazabilidad total y registros al día sin papeleo infinito.",
    Icon: ShieldCheckIcon,
  },
];
---

<section class="bg-surface py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <FadeInView client:visible className="text-center">
      <h2 class="font-heading text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl">
        IA de verdad. Resultados en semanas.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
        Olvídate de promesas vacías. Somos un equipo de IA que empezó resolviendo los problemas reales de la industria alimentaria.
      </p>
    </FadeInView>

    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      {differentiators.map((item, index) => {
        const Icon = item.Icon;
        return (
          <FadeInView client:visible delay={index * 0.1}>
            <div class="group rounded-none border border-gray-200 bg-white p-6 transition-all hover:border-brand-200 hover:shadow-lg">
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-brand-50 transition-colors group-hover:bg-brand-100">
                  <Icon className="h-6 w-6 text-brand-600" />
                </div>
                <div>
                  <h3 class="font-heading text-lg font-bold text-gray-900">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-gray-600">
                    {item.description}
                  </p>
                </div>
              </div>
            </div>
          </FadeInView>
        );
      })}
    </div>
  </div>
</section>
