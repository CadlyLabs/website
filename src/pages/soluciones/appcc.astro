---
import Layout from "../../layouts/Layout.astro";
import { FadeInView } from "../../components/animations/FadeInView";

const calendlyUrl = "https://calendly.com/cadlylabs/20min";
---

<Layout
  title="APPCC y Trazabilidad Digital | Cadly Labs"
  description="Trazabilidad completa lote a lote y controles APPCC digitales. El inspector pregunta, dos clics y listo."
  canonical="https://cadlylabs.com/soluciones/appcc"
>
  <main class="relative flex flex-col overflow-x-hidden bg-white">
    <!-- Section 1: Hero -->
    <section class="relative min-h-[100dvh] flex items-center px-4 py-20 md:py-0 bg-brand-50/30">
      <div class="w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <FadeInView client:visible className="text-left">
          <h1 class="font-serif text-5xl md:text-7xl font-bold mb-6 leading-tight text-gray-900">
            APPCC y Trazabilidad Digital
          </h1>
          <p class="text-xl md:text-2xl text-gray-700 mb-8 font-light">
            El inspector pregunta, dos clics y listo
          </p>
          <p class="text-base md:text-lg text-gray-600 mb-12 leading-relaxed max-w-xl">
            Trazabilidad completa lote a lote desde el origen hasta el destino. Controles APPCC digitales automatizados. Alertas de caducidad en tiempo real y reportes listos para inspecciones.
          </p>
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer">
            <button class="bg-brand-600 hover:bg-brand-700 text-white px-8 py-4 rounded-lg font-semibold transition-colors text-lg">
              Ver cómo funciona
            </button>
          </a>
        </FadeInView>
        <FadeInView client:visible delay={0.2} className="hidden lg:block">
          <div class="aspect-square bg-gray-200 rounded-3xl overflow-hidden relative">
            <img
              src="https://picsum.photos/seed/appcchero/800/800"
              alt="Plataforma APPCC"
              class="w-full h-full object-cover"
            />
          </div>
        </FadeInView>
      </div>
    </section>

    <!-- Section 2: How it works -->
    <section class="py-24 md:py-32 px-4 bg-white">
      <div class="max-w-6xl mx-auto">
        <FadeInView client:visible className="mb-20 text-center">
          <h2 class="font-serif text-4xl md:text-5xl font-bold mb-6 text-gray-900">
            Cómo funciona
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Tres pasos simples para digitalizar tu gestión alimentaria
          </p>
        </FadeInView>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <FadeInView client:visible delay={0.1} className="flex flex-col items-start">
            <div class="w-16 h-16 rounded-2xl bg-brand-600/10 text-brand-600 flex items-center justify-center mb-6 font-bold text-2xl">
              1
            </div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900">Registra los controles en el móvil</h3>
            <p class="text-gray-600 leading-relaxed text-lg">
              Temperatura, limpieza, recepción de mercancía. Todo desde cualquier dispositivo sin necesidad de papel.
            </p>
          </FadeInView>

          <FadeInView client:visible delay={0.2} className="flex flex-col items-start">
            <div class="w-16 h-16 rounded-2xl bg-brand-600/10 text-brand-600 flex items-center justify-center mb-6 font-bold text-2xl">
              2
            </div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900">El sistema construye la trazabilidad</h3>
            <p class="text-gray-600 leading-relaxed text-lg">
              Lote a lote, origen, transformación, destino. Conexión total entre proveedores y clientes.
            </p>
          </FadeInView>

          <FadeInView client:visible delay={0.3} className="flex flex-col items-start">
            <div class="w-16 h-16 rounded-2xl bg-brand-600/10 text-brand-600 flex items-center justify-center mb-6 font-bold text-2xl">
              3
            </div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900">Auditoría lista en segundos</h3>
            <p class="text-gray-600 leading-relaxed text-lg">
              Reportes automáticos para inspecciones. Encuentra cualquier registro al instante.
            </p>
          </FadeInView>
        </div>
      </div>
    </section>

    <!-- Section 3: Social proof -->
    <section class="py-24 md:py-32 px-4 bg-gray-50">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <FadeInView client:visible>
            <h2 class="font-serif text-4xl md:text-5xl font-bold mb-8 text-gray-900">
              Probado en el sector
            </h2>
            <p class="text-xl text-gray-600 mb-10 leading-relaxed">
              Implementado en Montes del Acebo, empresa cárnica con más de 30 años de historia. Una solución real para problemas reales del día a día.
            </p>
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 inline-block">
              <img 
                src="/images/logos/montes_acebo_logo.avif" 
                alt="Logo Montes del Acebo" 
                class="h-16 w-auto object-contain opacity-80 grayscale hover:grayscale-0 transition-all duration-300"
              />
            </div>
          </FadeInView>

          <FadeInView client:visible delay={0.2}>
            <div class="aspect-square md:aspect-[4/3] bg-gray-200 rounded-3xl overflow-hidden relative">
              <img
                src="https://picsum.photos/seed/appcc/800/600"
                alt="Interfaz de la plataforma APPCC"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
            </div>
          </FadeInView>
        </div>
      </div>
    </section>

    <!-- Section 4: Results -->
    <section class="py-24 md:py-32 px-4 bg-white">
      <div class="max-w-6xl mx-auto">
        <FadeInView client:visible className="mb-20 text-center">
          <h2 class="font-serif text-4xl md:text-5xl font-bold mb-6 text-gray-900">
            Resultados claros
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Lo que consigues al digitalizar tu gestión
          </p>
        </FadeInView>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <FadeInView client:visible delay={0.1}>
            <div class="p-10 rounded-3xl bg-gray-50 border border-gray-100 h-full">
              <div class="w-12 h-12 rounded-full bg-brand-600/10 flex items-center justify-center mb-6">
                <svg class="w-6 h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold mb-4 text-gray-900">Trazabilidad completa</h3>
              <p class="text-gray-600 leading-relaxed">
                Visibilidad total del recorrido de cada producto. Desde la entrada hasta la salida.
              </p>
            </div>
          </FadeInView>

          <FadeInView client:visible delay={0.2}>
            <div class="p-10 rounded-3xl bg-gray-50 border border-gray-100 h-full">
              <div class="w-12 h-12 rounded-full bg-brand-600/10 flex items-center justify-center mb-6">
                <svg class="w-6 h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold mb-4 text-gray-900">Alertas de caducidad</h3>
              <p class="text-gray-600 leading-relaxed">
                Avisos automáticos antes de que los productos caduquen. Menos desperdicio.
              </p>
            </div>
          </FadeInView>

          <FadeInView client:visible delay={0.3}>
            <div class="p-10 rounded-3xl bg-gray-50 border border-gray-100 h-full">
              <div class="w-12 h-12 rounded-full bg-brand-600/10 flex items-center justify-center mb-6">
                <svg class="w-6 h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold mb-4 text-gray-900">Reportes para auditoría</h3>
              <p class="text-gray-600 leading-relaxed">
                Documentación generada al instante. Tranquilidad total ante cualquier inspección.
              </p>
            </div>
          </FadeInView>
        </div>
      </div>
    </section>

    <!-- Section 5: CTA -->
    <section class="py-24 md:py-32 px-4 bg-brand-600 text-white">
      <div class="max-w-4xl mx-auto text-center">
        <FadeInView client:visible>
          <h2 class="font-serif text-4xl md:text-6xl font-bold mb-8">
            ¿Quieres verlo en acción?
          </h2>
          <p class="text-xl md:text-2xl text-white/90 mb-12 font-light max-w-2xl mx-auto">
            Agenda una llamada de 20 minutos y te mostramos cómo transformar tus procesos.
          </p>
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer">
            <button class="bg-white text-brand-600 hover:bg-gray-50 px-10 py-4 rounded-lg font-bold transition-colors text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1">
              Agendar llamada
            </button>
          </a>
        </FadeInView>
      </div>
    </section>
  </main>
</Layout>
