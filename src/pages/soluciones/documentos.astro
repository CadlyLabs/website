---
import Layout from "../../layouts/Layout.astro";
import { FadeInView } from "../../components/animations/FadeInView";

const calendlyUrl = "https://calendly.com/cadlylabs/20min";
const heroColor = "#FF8532";
---

<Layout
  title="Agente de Documentos | Cadly Labs"
  description="Fotografía o PDF de un albarán, factura o certificado. En 10 segundos está en tu sistema. Maneja escritura a mano, formatos variables y layouts raros. Los datos van directos a tu ERP o Excel."
  canonical="https://cadlylabs.com/soluciones/documentos"
>
  <main class="relative flex flex-col overflow-x-hidden">
    <!-- Section 1: Hero -->
    <section
      class="relative min-h-[100dvh] flex items-center px-4 py-20 md:py-0"
      style={{ backgroundColor: heroColor + "15" }}
    >
      <div class="w-full max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <FadeInView client:visible className="flex flex-col items-start text-left">
          <h1
            class="font-serif text-5xl md:text-7xl font-bold mb-6 leading-tight"
            style={{ color: heroColor }}
          >
            Agente de Documentos
          </h1>
          <p class="text-xl md:text-2xl text-gray-800 mb-6 font-medium">
            Albaranes y facturas que se procesan solos
          </p>
          <p class="text-base md:text-lg text-gray-600 mb-10 leading-relaxed max-w-[65ch]">
            Fotografía o PDF de un albarán, factura o certificado. En 10 segundos está en tu sistema. Maneja escritura a mano, formatos variables y layouts raros. Los datos van directos a tu ERP o Excel.
          </p>
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer">
            <button class="bg-black hover:bg-gray-900 text-white px-8 py-4 rounded-lg font-semibold transition-colors text-lg">
              Reserva una llamada
            </button>
          </a>
        </FadeInView>
        <FadeInView client:visible delay={0.2} className="hidden md:block">
          <div class="w-full aspect-square bg-white/50 rounded-3xl border border-white/20 shadow-2xl flex items-center justify-center p-8">
            <div class="w-full h-full border-2 border-dashed border-gray-300 rounded-2xl flex items-center justify-center bg-gray-50/50">
              <p class="text-gray-400 font-medium">Visualización del Agente</p>
            </div>
          </div>
        </FadeInView>
      </div>
    </section>

    <!-- Section 2: How it works -->
    <section class="py-24 md:py-32 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <FadeInView client:visible className="mb-20">
          <h2 class="font-serif text-4xl md:text-6xl font-bold mb-6 tracking-tighter">
            Cómo funciona
          </h2>
          <p class="text-xl text-gray-600 max-w-[65ch]">
            Tres pasos simples para automatizar la entrada de datos
          </p>
        </FadeInView>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <FadeInView client:visible delay={0.1} className="flex flex-col items-start">
            <div
              class="w-16 h-16 rounded-2xl flex items-center justify-center mb-8 font-bold text-white text-2xl shadow-lg"
              style={{ backgroundColor: heroColor }}
            >
              1
            </div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900">Fotografía o sube el documento</h3>
            <p class="text-gray-600 leading-relaxed text-lg">WhatsApp, email, o portal web</p>
          </FadeInView>

          <FadeInView client:visible delay={0.2} className="flex flex-col items-start">
            <div
              class="w-16 h-16 rounded-2xl flex items-center justify-center mb-8 font-bold text-white text-2xl shadow-lg"
              style={{ backgroundColor: heroColor }}
            >
              2
            </div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900">El agente extrae los datos</h3>
            <p class="text-gray-600 leading-relaxed text-lg">En menos de 10 segundos, con precisión del 99%</p>
          </FadeInView>

          <FadeInView client:visible delay={0.3} className="flex flex-col items-start">
            <div
              class="w-16 h-16 rounded-2xl flex items-center justify-center mb-8 font-bold text-white text-2xl shadow-lg"
              style={{ backgroundColor: heroColor }}
            >
              3
            </div>
            <h3 class="text-2xl font-bold mb-4 text-gray-900">Los datos entran en tu sistema</h3>
            <p class="text-gray-600 leading-relaxed text-lg">ERP, Excel, o donde los necesites</p>
          </FadeInView>
        </div>
      </div>
    </section>

    <!-- Section 3: ERP logos -->
    <section class="py-24 md:py-32 px-4 bg-gray-50 border-y border-gray-100">
      <div class="max-w-7xl mx-auto">
        <FadeInView client:visible className="mb-16 text-center">
          <h2 class="font-serif text-3xl md:text-5xl font-bold mb-12 tracking-tighter">
            Compatible con tu ERP
          </h2>
        </FadeInView>

        <FadeInView client:visible delay={0.2}>
          <div class="flex flex-wrap justify-center items-center gap-12 md:gap-20 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
            <img src="/images/erps_logos/sap.png" alt="Logo de SAP" class="h-12 md:h-16 object-contain" />
            <img src="/images/erps_logos/dynamics.png" alt="Logo de Microsoft Dynamics" class="h-10 md:h-14 object-contain" />
            <img src="/images/erps_logos/a3erp.png" alt="Logo de A3 ERP" class="h-10 md:h-14 object-contain" />
            <img src="/images/erps_logos/holded.png" alt="Logo de Holded" class="h-8 md:h-12 object-contain" />
            <img src="/images/erps_logos/sage.png" alt="Logo de Sage" class="h-10 md:h-14 object-contain" />
            <img src="/images/erps_logos/odoo.png" alt="Logo de Odoo" class="h-10 md:h-14 object-contain" />
          </div>
        </FadeInView>
      </div>
    </section>

    <!-- Section 4: Results/Metrics -->
    <section class="py-24 md:py-32 px-4 bg-white">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <FadeInView client:visible>
          <h2 class="font-serif text-4xl md:text-6xl font-bold mb-8 tracking-tighter leading-tight">
            Sin plantillas. Sin configuración por proveedor. Funciona desde el primer documento.
          </h2>
        </FadeInView>

        <FadeInView client:visible delay={0.2}>
          <div class="p-12 border border-gray-200 rounded-3xl bg-gray-50">
            <p class="text-6xl md:text-8xl font-bold mb-4 tracking-tighter" style={{ color: heroColor }}>
              10s
            </p>
            <p class="text-2xl text-gray-900 font-medium">
              Menos de 10 segundos por documento
            </p>
          </div>
        </FadeInView>
      </div>
    </section>

    <!-- Section 5: CTA -->
    <section
      class="py-24 md:py-32 px-4"
      style={{ backgroundColor: heroColor + "10" }}
    >
      <div class="max-w-4xl mx-auto text-center">
        <FadeInView client:visible>
          <h2 class="font-serif text-5xl md:text-7xl font-bold mb-8 tracking-tighter">
            ¿Quieres verlo en acción?
          </h2>
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer">
            <button class="bg-black hover:bg-gray-900 text-white px-10 py-5 rounded-xl font-bold transition-colors text-xl shadow-xl hover:shadow-2xl hover:-translate-y-1 transform duration-200">
              Reserva una llamada
            </button>
          </a>
        </FadeInView>
      </div>
    </section>
  </main>
</Layout>
