---
import Layout from "../../layouts/Layout.astro";
import { SERVICES } from "../../data/services";
import { FadeInView } from "../../components/animations/FadeInView";
---

<Layout
  title="Nuestras Soluciones | Cadly Labs"
  description="Soluciones de IA especializadas para optimizar tus procesos en la industria alimentaria"
  canonical="https://cadlylabs.com/soluciones"
>
  title="Nuestras Soluciones"
  description="Soluciones de IA especializadas para la industria alimentaria"
  canonical="https://cadlylabs.com/soluciones"
>
  <main class="relative flex flex-col overflow-x-hidden">
    <!-- Hero Section -->
    <section class="min-h-[100dvh] flex items-center justify-center px-4 py-20 md:py-0 bg-gradient-to-br from-gray-50 to-white">
      <div class="max-w-4xl mx-auto text-center">
        <FadeInView client:visible>
          <h1 class="font-serif text-5xl md:text-7xl font-bold mb-6 leading-tight">
            Nuestras Soluciones
          </h1>
          <p class="text-xl md:text-2xl text-gray-700 mb-8 font-light">
            Soluciones de IA especializadas para optimizar tus procesos en la industria alimentaria
          </p>
        </FadeInView>
      </div>
    </section>

    <!-- Solutions Grid -->
    <section class="py-20 md:py-32 px-4 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {SERVICES.map((service, index) => (
            <FadeInView
              client:visible
              delay={index * 0.1}
              className="group"
            >
              <a
                href={`/soluciones/${service.slug}`}
                class="block h-full p-8 border border-gray-200 rounded-2xl hover:border-gray-300 hover:shadow-lg transition-all duration-300"
              >
                <div
                  class="w-12 h-12 rounded-lg flex items-center justify-center mb-4"
                  style={{ backgroundColor: service.heroColor + "20" }}
                >
                  <div
                    class="w-6 h-6 rounded"
                    style={{ backgroundColor: service.heroColor }}
                  />
                </div>
                <h3 class="font-serif text-2xl font-bold mb-3 group-hover:text-gray-900 transition-colors">
                  {service.title}
                </h3>
                <p class="text-gray-600 mb-4 leading-relaxed">
                  {service.tagline}
                </p>
                <p class="text-sm text-gray-500 group-hover:text-gray-700 transition-colors">
                  Descubre más →
                </p>
              </a>
            </FadeInView>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 md:py-32 px-4 bg-gray-50">
      <div class="max-w-3xl mx-auto text-center">
        <FadeInView client:visible>
          <h2 class="font-serif text-4xl md:text-5xl font-bold mb-6">
            ¿No sabes por dónde empezar?
          </h2>
          <p class="text-lg text-gray-700 mb-8">
            Agenda una llamada con nuestro equipo. Te ayudaremos a identificar la solución perfecta para tu negocio.
          </p>
          <a
            href="https://calendly.com/cadlylabs/20min"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-black hover:bg-gray-900 text-white px-8 py-3 rounded-lg font-semibold transition-colors"
          >
            Agendar llamada
          </a>
        </FadeInView>
      </div>
    </section>
  </main>
</Layout>
