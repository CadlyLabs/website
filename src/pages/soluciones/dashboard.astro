---
import Layout from "../../layouts/Layout.astro";
import { FadeInView } from "../../components/animations/FadeInView";

const calendlyUrl = "https://calendly.com/cadlylabs/20min";
const heroColor = "#FF9A5C";
---

<Layout
  title="Dashboard de Operaciones | Cadly Labs"
  description="Stock, márgenes y caducidades en tiempo real. Visibilidad total de tus operaciones."
  canonical="https://cadlylabs.com/soluciones/dashboard"
>
  <main class="relative flex flex-col overflow-x-hidden">
    <!-- Section 1: Hero -->
    <section
      class="relative min-h-[100dvh] flex items-center justify-center px-4 py-20 md:py-0"
      style={{ backgroundColor: heroColor + "15" }}
    >
      <FadeInView client:visible className="w-full max-w-4xl mx-auto text-left md:text-center">
        <h1
          class="font-serif text-5xl md:text-7xl font-bold mb-6 leading-tight"
          style={{ color: heroColor }}
        >
          Dashboard de Operaciones
        </h1>
        <p class="text-xl md:text-2xl text-gray-700 mb-8 font-light">
          Stock, márgenes y caducidades en tiempo real
        </p>
        <p class="text-base md:text-lg text-gray-600 mb-12 max-w-2xl md:mx-auto leading-relaxed">
          Visibilidad total de tu negocio. Se alimenta automáticamente de tus datos para que dejes de operar a ciegas.
        </p>
        <a href={calendlyUrl} target="_blank" rel="noopener noreferrer">
          <button class="bg-black hover:bg-gray-900 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
            Agendar llamada
          </button>
        </a>
      </FadeInView>
    </section>

    <!-- Section 2: How it works -->
    <section class="py-20 md:py-32 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <FadeInView client:visible className="mb-16">
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-center mb-4">
            Cómo funciona
          </h2>
          <p class="text-center text-gray-600 text-lg">
            Tres pasos simples para implementar esta solución
          </p>
        </FadeInView>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <FadeInView client:visible delay={0} className="flex flex-col items-start">
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center mb-4 font-bold text-white text-lg"
              style={{ backgroundColor: heroColor }}
            >
              1
            </div>
            <h3 class="text-xl font-bold mb-2">Conectamos tus fuentes de datos</h3>
            <p class="text-gray-700 leading-relaxed">
              ERP, hojas de cálculo y documentos procesados por el Agente.
            </p>
          </FadeInView>

          <FadeInView client:visible delay={0.1} className="flex flex-col items-start">
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center mb-4 font-bold text-white text-lg"
              style={{ backgroundColor: heroColor }}
            >
              2
            </div>
            <h3 class="text-xl font-bold mb-2">El dashboard se actualiza solo</h3>
            <p class="text-gray-700 leading-relaxed">
              Sin exportar, sin copiar, sin esperar al cierre del mes.
            </p>
          </FadeInView>

          <FadeInView client:visible delay={0.2} className="flex flex-col items-start">
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center mb-4 font-bold text-white text-lg"
              style={{ backgroundColor: heroColor }}
            >
              3
            </div>
            <h3 class="text-xl font-bold mb-2">Tomas decisiones con datos reales</h3>
            <p class="text-gray-700 leading-relaxed">
              Stock por lote, márgenes por producto y alertas de caducidad.
            </p>
          </FadeInView>
        </div>
      </div>
    </section>

    <!-- Section 3: Visual placeholder -->
    <section class="py-20 md:py-32 px-4 bg-gray-50">
      <div class="max-w-5xl mx-auto">
        <FadeInView client:visible className="mb-12">
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-center mb-4">
            Visualización
          </h2>
          <p class="text-center text-gray-600 text-lg max-w-2xl mx-auto">
            Todo lo que necesitas saber, en una sola pantalla.
          </p>
        </FadeInView>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <FadeInView client:visible>
            <picture class="block w-full shadow-2xl rounded-2xl overflow-hidden">
              <source
                srcset="data:image/avif,base64,AAAAHGZ0eXBhdmlmAAAAAG1pZjEAAAGqbWV0YQAAAAAAAAAoaGRscgAAAAAAAAAAAAAAL2lkYXQAAAAAAAAA0AAAANAAAAA="
                type="image/avif"
              />
              <source
                srcset="data:image/webp,UklGRiYAAABXRUJQVlA4IBIAAAAwAQCdASoBAAEAAUAcJaACdLoB/gAA/v8A/v8A"
                type="image/webp"
              />
              <img
                src="data:image/png,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
                alt="Placeholder para imagen del Dashboard de Operaciones"
                class="w-full aspect-video bg-gray-200 object-cover"
              />
            </picture>
            <p class="text-center text-gray-500 text-sm mt-4">
              Imagen de demostración
            </p>
          </FadeInView>

          <FadeInView client:visible delay={0.2}>
            <ul class="space-y-6">
              <li class="flex items-start gap-4">
                <div class="w-6 h-6 rounded-full mt-1 flex-shrink-0" style={{ backgroundColor: heroColor }}></div>
                <div>
                  <h4 class="text-xl font-bold mb-1">Stock en tiempo real</h4>
                  <p class="text-gray-600">Control exacto de inventario por lote y ubicación.</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="w-6 h-6 rounded-full mt-1 flex-shrink-0" style={{ backgroundColor: heroColor }}></div>
                <div>
                  <h4 class="text-xl font-bold mb-1">Márgenes por producto</h4>
                  <p class="text-gray-600">Rentabilidad actualizada al instante.</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="w-6 h-6 rounded-full mt-1 flex-shrink-0" style={{ backgroundColor: heroColor }}></div>
                <div>
                  <h4 class="text-xl font-bold mb-1">Pedidos pendientes</h4>
                  <p class="text-gray-600">Estado de entregas y preparación en curso.</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="w-6 h-6 rounded-full mt-1 flex-shrink-0" style={{ backgroundColor: heroColor }}></div>
                <div>
                  <h4 class="text-xl font-bold mb-1">Alertas de caducidad</h4>
                  <p class="text-gray-600">Avisos automáticos antes de perder producto.</p>
                </div>
              </li>
            </ul>
          </FadeInView>
        </div>
      </div>
    </section>

    <!-- Section 4: Results/Metrics -->
    <section class="py-20 md:py-32 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <FadeInView client:visible className="mb-16">
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-center mb-6">
            ¿Sabes cuánto stock tienes ahora mismo?
          </h2>
          <p class="text-center text-gray-600 text-lg max-w-2xl mx-auto">
            Dejar de operar a ciegas significa reducir mermas, optimizar compras y mejorar la rentabilidad de cada lote.
          </p>
        </FadeInView>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <FadeInView client:visible delay={0}>
            <div class="p-8 border border-gray-200 rounded-2xl h-full">
              <p class="text-4xl font-bold mb-2" style={{ color: heroColor }}>
                Cero
              </p>
              <p class="text-gray-700">Sorpresas al final del mes</p>
            </div>
          </FadeInView>

          <FadeInView client:visible delay={0.1}>
            <div class="p-8 border border-gray-200 rounded-2xl h-full">
              <p class="text-4xl font-bold mb-2" style={{ color: heroColor }}>
                100%
              </p>
              <p class="text-gray-700">Visibilidad de márgenes reales</p>
            </div>
          </FadeInView>

          <FadeInView client:visible delay={0.2}>
            <div class="p-8 border border-gray-200 rounded-2xl h-full">
              <p class="text-4xl font-bold mb-2" style={{ color: heroColor }}>
                Total
              </p>
              <p class="text-gray-700">Control sobre caducidades</p>
            </div>
          </FadeInView>
        </div>
      </div>
    </section>

    <!-- Section 5: CTA -->
    <section
      class="py-20 md:py-32 px-4"
      style={{ backgroundColor: heroColor + "10" }}
    >
      <div class="max-w-3xl mx-auto text-center">
        <FadeInView client:visible>
          <h2 class="font-serif text-4xl md:text-5xl font-bold mb-6">
            ¿Quieres verlo en acción?
          </h2>
          <p class="text-lg text-gray-700 mb-8">
            Agenda una llamada de 20 minutos y te mostramos cómo el Dashboard de Operaciones puede transformar tu negocio.
          </p>
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer">
            <button class="bg-black hover:bg-gray-900 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
              Agendar llamada
            </button>
          </a>
        </FadeInView>
      </div>
    </section>
  </main>
</Layout>
