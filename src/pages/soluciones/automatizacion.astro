---
import Layout from "../../layouts/Layout.astro";
import { FadeInView } from "../../components/animations/FadeInView";

const calendlyUrl = "https://calendly.com/cadlylabs/20min";
const heroColor = "#FF6020";
---

<Layout
  title="Orquestación de Procesos | Cadly Labs"
  description="Flujos de trabajo complejos automatizados paso a paso. Mapeamos tu flujo actual, construimos los agentes y el flujo corre solo."
  canonical="https://cadlylabs.com/soluciones/automatizacion"
>
  <main class="relative flex flex-col overflow-x-hidden">
    <!-- Section 1: Hero -->
    <section
      class="relative min-h-[100dvh] flex items-center px-4 py-20 md:py-0"
      style={{ backgroundColor: heroColor + "15" }}
    >
      <div class="w-full max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <FadeInView client:visible className="flex flex-col items-start text-left">
          <h1
            class="font-serif text-5xl md:text-7xl font-bold mb-6 leading-tight"
            style={{ color: heroColor }}
          >
            Orquestación de Procesos
          </h1>
          <p class="text-xl md:text-2xl text-gray-700 mb-8 font-light">
            Flujos de trabajo complejos automatizados paso a paso
          </p>
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer">
            <button class="bg-black hover:bg-gray-900 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
              Agendar llamada
            </button>
          </a>
        </FadeInView>
        <FadeInView client:visible delay={0.2} className="hidden md:block">
          <div class="w-full aspect-square bg-white/50 rounded-3xl border border-white/20 shadow-2xl flex items-center justify-center p-8">
            <div class="w-full h-full border-2 border-dashed border-gray-300 rounded-2xl flex items-center justify-center text-gray-400">
              Visualización del flujo
            </div>
          </div>
        </FadeInView>
      </div>
    </section>

    <!-- Section 2: How it works -->
    <section class="py-20 md:py-32 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <FadeInView client:visible className="mb-16">
          <h2 class="font-serif text-4xl md:text-5xl font-bold mb-4">
            Cómo funciona
          </h2>
        </FadeInView>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <FadeInView client:visible delay={0.1} className="flex flex-col items-start">
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center mb-6 font-bold text-white text-lg"
              style={{ backgroundColor: heroColor }}
            >
              1
            </div>
            <h3 class="text-2xl font-bold mb-4">Mapeamos tu flujo actual</h3>
            <p class="text-gray-700 leading-relaxed">
              Entendemos cada paso, cada sistema, cada excepción.
            </p>
          </FadeInView>

          <FadeInView client:visible delay={0.2} className="flex flex-col items-start">
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center mb-6 font-bold text-white text-lg"
              style={{ backgroundColor: heroColor }}
            >
              2
            </div>
            <h3 class="text-2xl font-bold mb-4">Construimos los agentes</h3>
            <p class="text-gray-700 leading-relaxed">
              Cada agente hace una cosa bien, coordinados entre sí.
            </p>
          </FadeInView>

          <FadeInView client:visible delay={0.3} className="flex flex-col items-start">
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center mb-6 font-bold text-white text-lg"
              style={{ backgroundColor: heroColor }}
            >
              3
            </div>
            <h3 class="text-2xl font-bold mb-4">El flujo corre solo</h3>
            <p class="text-gray-700 leading-relaxed">
              Con supervisión humana donde importa, automatizado donde no.
            </p>
          </FadeInView>
        </div>
      </div>
    </section>

    <!-- Section 3: Visual -->
    <section class="py-20 md:py-32 px-4 bg-gray-50">
      <div class="max-w-7xl mx-auto">
        <FadeInView client:visible className="mb-12">
          <h2 class="font-serif text-4xl md:text-5xl font-bold mb-4">
            Un ejemplo real
          </h2>
        </FadeInView>

        <FadeInView client:visible>
          <div class="bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-gray-100">
            <div class="w-full aspect-video bg-gray-100 rounded-2xl mb-12 flex items-center justify-center text-gray-400">
              Imagen de demostración
            </div>
            <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left font-medium text-gray-800">
              <div class="px-6 py-4 bg-gray-50 rounded-xl border border-gray-200 w-full md:w-auto">Pedido recibido</div>
              <div class="text-gray-400 rotate-90 md:rotate-0">→</div>
              <div class="px-6 py-4 bg-gray-50 rounded-xl border border-gray-200 w-full md:w-auto">Chequeo de stock</div>
              <div class="text-gray-400 rotate-90 md:rotate-0">→</div>
              <div class="px-6 py-4 bg-gray-50 rounded-xl border border-gray-200 w-full md:w-auto">Orden a proveedor si falta</div>
              <div class="text-gray-400 rotate-90 md:rotate-0">→</div>
              <div class="px-6 py-4 bg-gray-50 rounded-xl border border-gray-200 w-full md:w-auto">Programación de producción</div>
              <div class="text-gray-400 rotate-90 md:rotate-0">→</div>
              <div class="px-6 py-4 bg-gray-50 rounded-xl border border-gray-200 w-full md:w-auto">Confirmación al cliente</div>
            </div>
          </div>
        </FadeInView>
      </div>
    </section>

    <!-- Section 4: Results -->
    <section class="py-20 md:py-32 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <FadeInView client:visible className="mb-16">
          <h2 class="font-serif text-4xl md:text-5xl font-bold mb-4">
            Cada cliente tiene su flujo. Nosotros lo automatizamos.
          </h2>
        </FadeInView>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <FadeInView client:visible delay={0.1}>
            <div class="p-8 border border-gray-200 rounded-2xl h-full">
              <h3 class="text-2xl font-bold mb-4" style={{ color: heroColor }}>
                Ahorro de tiempo
              </h3>
              <p class="text-gray-700">
                Horas liberadas cada semana al eliminar tareas manuales repetitivas.
              </p>
            </div>
          </FadeInView>

          <FadeInView client:visible delay={0.2}>
            <div class="p-8 border border-gray-200 rounded-2xl h-full">
              <h3 class="text-2xl font-bold mb-4" style={{ color: heroColor }}>
                Eliminación de errores
              </h3>
              <p class="text-gray-700">
                Precisión absoluta en la transferencia de datos entre sistemas.
              </p>
            </div>
          </FadeInView>

          <FadeInView client:visible delay={0.3}>
            <div class="p-8 border border-gray-200 rounded-2xl h-full">
              <h3 class="text-2xl font-bold mb-4" style={{ color: heroColor }}>
                Crecimiento sin contratar más personal
              </h3>
              <p class="text-gray-700">
                Multiplica tu capacidad operativa manteniendo el mismo equipo.
              </p>
            </div>
          </FadeInView>
        </div>
      </div>
    </section>

    <!-- Section 5: CTA -->
    <section
      class="py-20 md:py-32 px-4"
      style={{ backgroundColor: heroColor + "10" }}
    >
      <div class="max-w-3xl mx-auto text-center">
        <FadeInView client:visible>
          <h2 class="font-serif text-4xl md:text-5xl font-bold mb-6">
            ¿Quieres verlo en acción?
          </h2>
          <p class="text-lg text-gray-700 mb-8">
            Agenda una llamada de 20 minutos y te mostramos cómo podemos optimizar tus procesos.
          </p>
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer">
            <button class="bg-black hover:bg-gray-900 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
              Agendar llamada
            </button>
          </a>
        </FadeInView>
      </div>
    </section>
  </main>
</Layout>
