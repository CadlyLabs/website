---
import Layout from "../layouts/Layout.astro";
import SkipLink from "@/components/SkipLink.astro";
import { Navbar } from "@/components/sections/Navbar";
import { Hero } from "@/components/sections/Hero";
import { FoodServices } from "@/components/sections/FoodServices";
import SuccessStory from "@/components/sections/SuccessStory.astro";
import { HowWeWork } from "@/components/sections/HowWeWork";
import WhyCadly from "@/components/sections/WhyCadly.astro";
import { Contact } from "@/components/sections/Contact";
import Footer from "@/components/sections/Footer.astro";
---

<Layout>
  <SkipLink />
  <main
    id="main-content"
    class="relative flex flex-col scrollbar-custom overflow-y-auto h-dvh overflow-x-hidden"
  >
    <Navbar client:load />
    <Hero client:load />
    <FoodServices client:visible />
    <SuccessStory />
    <HowWeWork client:visible />
    <WhyCadly />
    <Contact client:load />
    <Footer />
  </main>
</Layout>
